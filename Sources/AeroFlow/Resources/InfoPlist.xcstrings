{
  "sourceLanguage": "en",
  "strings": {
    "NSScreenCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow uses screen capture for Overview thumbnails, window drag previews, and Hidden Bar icons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow は、オーバービューのサムネイル、ウィンドウのドラッグプレビュー、隠しバーのアイコンのために画面収録を使用します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow verwendet Bildschirmaufnahmen für Vorschaubilder in der Übersicht, Vorschauen beim Ziehen von Fenstern und Symbole der versteckten Leiste."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow bruker skjermopptak til miniatyrbilder i Oversikt, forhåndsvisninger ved vindusdraing og ikoner i Skjult linje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow använder skärmfångst för miniatyrbilder i Översikt, förhandsvisningar vid fönsterdragning och ikoner i Hidden Bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow usa la captura de pantalla para las miniaturas de Vista general, las vistas previas al arrastrar ventanas y los iconos de Barra oculta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow 使用屏幕录制生成概览缩略图、窗口拖动预览和隐藏栏图标。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow ओवरव्यू थंबनेल, विंडो ड्रैग प्रीव्यू और हिडन बार आइकन के लिए स्क्रीन कैप्चर का उपयोग करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم AeroFlow التقاط الشاشة لإنشاء الصور المصغرة لميزة «نظرة عامة»، ومعاينات سحب النوافذ، وأيقونات الشريط المخفي."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow koristi snimanje ekrana za sličice Pregleda, prikaze pri prevlačenju prozora i ikone Skrivene trake."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AeroFlow χρησιμοποιεί καταγραφή οθόνης για τις μικρογραφίες της Επισκόπησης, τις προεπισκοπήσεις μεταφοράς παραθύρων και τα εικονίδια της Κρυφής γραμμής."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow משתמש בצילום מסך עבור תמונות ממוזערות ב-Overview, תצוגות מקדימות של גרירת חלונות וסמלים ב-Hidden Bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow использует захват экрана для миниатюр Overview, предварительного просмотра перетаскиваемых окон и значков Hidden Bar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow korzysta z przechwytywania ekranu do miniatur w Overview, podglądu przeciąganych okien i ikon w Hidden Bar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow використовує запис екрана для мініатюр Overview, попереднього перегляду під час перетягування вікон і піктограм Hidden Bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow utilise l’enregistrement de l’écran pour les vignettes d’Overview, les aperçus de déplacement des fenêtres et les icônes de Hidden Bar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow gebruikt schermopname voor miniaturen in Overview, voorbeelden bij het verslepen van vensters en pictogrammen in Hidden Bar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow usa la cattura dello schermo per le miniature di Overview, le anteprime durante il trascinamento delle finestre e le icone di Hidden Bar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow käyttää näytön tallennusta Overview-pienoiskuviin, ikkunoiden vetämisen esikatseluun ja Hidden Bar -kuvakkeisiin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow bruger skærmoptagelse til miniaturer i Overview, forhåndsvisninger ved vinduestræk og Hidden Bar-ikoner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AeroFlow은 Overview 축소판, 창 드래그 미리보기, Hidden Bar 아이콘에 화면 캡처를 사용합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
